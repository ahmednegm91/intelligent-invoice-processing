    {
      "parameters": {
        "resource": "document",
        "modelId": {
          "__rl": true,
          "value": "models/gemini-3.5-flash-lite",
          "mode": "list",
          "cachedResultName": "Gemini 3.5 Flash Lite"
        },
        "text": "You are a professional invoice data extraction system.\n\nAnalyze the attached invoice and extract:\n\n- supplier_name\n- invoice_number\n- invoice_date\n- currency\n- subtotal\n- tax\n- total\n- items (description, quantity, unit_price, line_total)\n\nRules:\n1. Support Arabic and English.\n2. Preserve all numbers using English digits (0-9).\n3. Never invent missing information.\n4. Use null for unavailable values.\n5. Return only valid JSON.\n6. Do not correct calculation errors.\n7. Do not include explanations or Markdown.",
        "inputType": "binary",
        "binaryPropertyName": "invoice_file",
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        1424,
        96
      ],
      "id": "c4bcce37-3bb3-42f6-b84a-3bd0e76d0918",
      "name": "PrimaryAI",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst raw = $json.content?.parts?.[0]?.text;\n\nif (!raw) {\n  throw new Error(\"AI returned no invoice data\");\n}\n\nlet invoice;\n\ntry {\n  invoice = JSON.parse(raw);\n} catch (error) {\n  throw new Error(\"Invalid AI JSON: \" + error.message);\n}\n\nreturn { json: invoice };\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1648,
        240
      ],
      "id": "e2145aad-2b09-430b-a0d2-22cb642ac65a",
      "name": "ParseInvoiceJSON",
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst original = $('InvoiceInput').first();\n\nif (!original.binary?.invoice_file) {\n  throw new Error('Original invoice file not found');\n}\n\nreturn {\n  json: {\n    ...original.json,\n    ai_fallback_used: true\n  },\n  binary: original.binary\n};\n"
      },
