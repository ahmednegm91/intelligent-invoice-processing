    {
      "parameters": {
        "jsCode": "\nconst file = $input.item.binary?.invoice_file;\n\nconst allowedTypes = {\n  pdf: 'application/pdf',\n  jpg: 'image/jpeg',\n  jpeg: 'image/jpeg',\n  png: 'image/png'\n};\n\nconst maxSize = 10 * 1024 * 1024;\n\nconst fileName = file?.fileName ?? '';\nconst extension = fileName.split('.').pop().toLowerCase();\nconst mimeType = file?.mimeType ?? '';\nconst size = Number(file?.bytes);\n\nlet errorCode;\nlet message;\n\nif (!file) {\n  errorCode = 'FILE_MISSING';\n  message = 'No file was uploaded.';\n} else if (allowedTypes[extension] !== mimeType) {\n  errorCode = 'UNSUPPORTED_FORMAT';\n  message = 'Only PDF, JPG, JPEG and PNG files are supported.';\n} else if (!Number.isFinite(size) || size <= 0) {\n  errorCode = 'INVALID_FILE_SIZE';\n  message = 'File size is missing or invalid.';\n} else if (size > maxSize) {\n  errorCode = 'FILE_TOO_LARGE';\n  message = 'The maximum allowed file size is 10 MB.';\n} else {\n  errorCode = 'INVALID_FILE';\n  message = 'The file failed validation.';\n}\n\nreturn {\n  json: {\n    status: 'rejected',\n    error_code: errorCode,\n    error_message: message,\n    file_name: fileName,\n    size_bytes: Number.isFinite(size) ? size : null\n  }\n};\n",
        "mode": "runOnceForEachItem"
      },
