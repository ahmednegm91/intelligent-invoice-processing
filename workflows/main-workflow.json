    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst invoice = $json;\n\nconst supplier = String(invoice.supplier_name ?? '')\n  .trim()\n  .toLowerCase()\n  .replace(/\\s+/g, ' ');\n\nconst invoiceNumber = String(invoice.invoice_number ?? '')\n  .trim()\n  .toUpperCase()\n  .replace(/\\s+/g, '');\n\nconst invoiceKey = supplier && invoiceNumber\n  ? `${supplier}|${invoiceNumber}`\n  : null;\n\nreturn {\n  json: {\n    ...invoice,\n    invoice_key: invoiceKey\n  }\n};\n"
      },
