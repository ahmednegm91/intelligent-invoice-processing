      "id": "1c759b15-3d2f-48d5-9f47-4e96394c4ab7",
      "name": "ValidateFileType"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst invoice = $json;\nconst issues = [];\n\nconst readNumber = (value, label) => {\n  if (value === null || value === undefined || value === '') {\n    issues.push(`${label}: missing value`);\n    return null;\n  }\n\n  const number = Number(value);\n\n  if (!Number.isFinite(number)) {\n    issues.push(`${label}: invalid number`);\n    return null;\n  }\n\n  return number;\n};\n\nconst different = (a, b) => Math.abs(a - b) > 0.02;\n\nlet itemsSum = 0;\nlet allItemsValid = true;\n\nif (!Array.isArray(invoice.items) || invoice.items.length === 0) {\n  issues.push('Items missing');\n  allItemsValid = false;\n} else {\n  invoice.items.forEach((item, index) => {\n    const quantity = readNumber(item?.quantity, `Item ${index + 1} quantity`);\n    const price = readNumber(item?.unit_price, `Item ${index + 1} unit price`);\n    const lineTotal = readNumber(item?.line_total, `Item ${index + 1} line total`);\n\n    if ([quantity, price, lineTotal].includes(null)) {\n      allItemsValid = false;\n      return;\n    }\n\n    if (quantity <= 0 || price < 0 || lineTotal < 0) {\n      issues.push(`Item ${index + 1}: invalid negative or zero value`);\n    }\n\n    if (different(quantity * price, lineTotal)) {\n      issues.push(`Item ${index + 1} total mismatch`);\n    }\n\n    itemsSum += lineTotal;\n  });\n}\n\nconst subtotal = readNumber(invoice.subtotal, 'Subtotal');\nconst tax = readNumber(invoice.tax, 'Tax');\nconst total = readNumber(invoice.total, 'Total');\n\nif (allItemsValid && subtotal !== null && different(itemsSum, subtotal)) {\n  issues.push('Subtotal mismatch');\n}\n\nif (subtotal !== null && tax !== null && total !== null &&\n    different(subtotal + tax, total)) {\n  issues.push('Total mismatch');\n}\n\nreturn {\n  json: {\n    ...invoice,\n    validation: {\n      status: issues.length ? 'needs_review' : 'passed',\n      issues,\n      calculated_subtotal: allItemsValid ? Number(itemsSum.toFixed(2)) : null,\n      calculated_total: subtotal !== null && tax !== null\n        ? Number((subtotal + tax).toFixed(2)) : null\n    }\n  }\n};\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
