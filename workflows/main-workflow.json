    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "\nconst invoice = $('CreateInvoiceKey').first().json;\n\nreturn {\n  json: {\n    ...invoice,\n    approval_status: 'needs_review',\n    review_reason: 'duplicate_invoice'\n  }\n};\n"
      },
